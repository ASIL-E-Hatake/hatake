{
  "$comment": "サイトの目次台帳。フレームワークを拡張したら、ここにトピックを1件足すのがサイト側への唯一の申し送り。キー表・例・よくある間違いは spec/*.json から自動で引くので手で書かない。契約は docs/site/protocol.ja.md。",
  "sections": [
    {
      "id": "dsl",
      "title": "機能別の書き方",
      "blurb": "「こうしたい」から引く。定義の書き方・書けるキー・つまずきどころ。"
    }
  ],
  "internal": [],
  "topics": [
    {
      "id": "page-basics",
      "section": "dsl",
      "title": "画面を1枚定義する",
      "blurb": "どの画面にも要る4つのキーと、レコードを1件に絞る key。",
      "keys": [
        "type",
        "id",
        "title",
        "repository",
        "key"
      ],
      "demo": "customer_master"
    },
    {
      "id": "table-columns",
      "section": "dsl",
      "title": "一覧に列を出す",
      "blurb": "表示する列、幅、並べ替え、値の見せ方。",
      "keys": [
        "table",
        "columns",
        "label",
        "width",
        "sortable",
        "format"
      ],
      "demo": "order_search"
    },
    {
      "id": "pagination",
      "section": "dsl",
      "title": "一覧をページングする",
      "blurb": "1ページの件数と、ページングを切る指定。",
      "keys": [
        "pagination",
        "enabled",
        "pageSize"
      ],
      "demo": "order_search"
    },
    {
      "id": "search-filters",
      "section": "dsl",
      "title": "検索条件を出す",
      "blurb": "検索欄に並べる条件と、比較のしかた（等値・部分一致・範囲）。",
      "keys": [
        "search",
        "filters",
        "operator",
        "options",
        "layout"
      ],
      "demo": "order_search"
    },
    {
      "id": "row-actions",
      "section": "dsl",
      "title": "行ごとの操作を付ける",
      "blurb": "編集・削除など、一覧の各行に出すボタン。",
      "keys": [
        "rowActions"
      ],
      "demo": "customer_master"
    },
    {
      "id": "actions",
      "section": "dsl",
      "title": "ボタンと処理を定義する",
      "blurb": "画面上部のアクション、組み込みの処理、独自処理の差し込み。",
      "keys": [
        "actions",
        "params",
        "plugin"
      ],
      "demo": "order_entry"
    },
    {
      "id": "confirm-and-after",
      "section": "dsl",
      "title": "確認ダイアログと成功後の動き",
      "blurb": "「本当に削除しますか」と「保存できたら一覧に戻る」を定義で書く。",
      "keys": [
        "confirm",
        "okLabel",
        "cancelLabel",
        "danger",
        "message",
        "onSuccess",
        "onError",
        "prompt"
      ],
      "demo": "customer_master"
    },
    {
      "id": "navigation",
      "section": "dsl",
      "title": "画面から画面へ遷移する",
      "blurb": "遷移先の指定と、渡す値。",
      "keys": [
        "page",
        "home"
      ],
      "demo": "order_detail"
    },
    {
      "id": "form-sections",
      "section": "dsl",
      "title": "入力フォームを組む",
      "blurb": "フォームをセクションに分け、項目を並べる。",
