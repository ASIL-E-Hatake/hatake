{
  "name": "@hatake-fw/api",
  "version": "0.9.3",
  "description": "Core definitions + parser + server-side validation for hatake (TypeScript edition). Consumes the language-agnostic hatake DSL.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "hatake": "dist/cli.js",
    "hatake-mcp": "dist/mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ASIL-E-Hatake/hatake"
  },
  "scripts": {
    "build": "tsc",
    "check-docs": "node tool/check-docs.mjs",
    "check-rules": "node tool/check-rules.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle-spec": "node tool/bundle-spec.mjs",
    "prepack": "node tool/bundle-spec.mjs && tsc",
    "check-versions": "node tool/check-versions.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
