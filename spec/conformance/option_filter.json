{
  "$comment": "選択肢の連動（カスケード）。親項目（optionsFrom）の現在値で、子項目の選択肢を絞る。`when` を書いていない選択肢は常に出る。値の比較は条件式と同じ緩い比較（'1' と 1 は同じ）。stale は「親が変わって、子が持っている値が選べなくなった」＝フォームが値を捨てる合図。Dart（visibleOptions / optionValueIsStale）と TypeScript が同じ結果になることを確認する。",
  "cases": [
    {
      "name": "optionsFrom が無ければ全部出る",
      "field": {
        "field": "city",
        "options": [
          { "value": "shibuya", "label": "渋谷区" },
          { "value": "kita", "label": "北区" }
        ]
      },
      "record": {},
      "visible": ["shibuya", "kita"],
      "stale": false
    },
    {
      "name": "親の値に合う選択肢だけ出る",
      "field": {
        "field": "city",
        "optionsFrom": "prefecture",
        "options": [
          { "value": "shibuya", "label": "渋谷区", "when": "tokyo" },
          { "value": "setagaya", "label": "世田谷区", "when": "tokyo" },
          { "value": "kita", "label": "北区", "when": "osaka" }
        ]
      },
      "record": { "prefecture": "tokyo" },
      "visible": ["shibuya", "setagaya"],
      "stale": false
    },
    {
      "name": "親が未入力なら when 付きは出ない（親を選ぶまで子は空）",
      "field": {
        "field": "city",
        "optionsFrom": "prefecture",
        "options": [
          { "value": "shibuya", "label": "渋谷区", "when": "tokyo" },
          { "value": "unknown", "label": "不明" }
        ]
      },
      "record": {},
      "visible": ["unknown"],
      "stale": false
    },
    {
      "name": "when を書いていない選択肢は常に出る（「その他」に使える）",
      "field": {
        "field": "city",
        "optionsFrom": "prefecture",
        "options": [
          { "value": "shibuya", "label": "渋谷区", "when": "tokyo" },
          { "value": "other", "label": "その他" }
        ]
      },
      "record": { "prefecture": "osaka" },
      "visible": ["other"],
      "stale": false
    },
    {
      "name": "数値と文字列は同じ値として比べる（条件式と同じ）",
      "field": {
        "field": "child",
        "optionsFrom": "parent",
        "options": [
          { "value": "a", "label": "A", "when": 1 },
          { "value": "b", "label": "B", "when": 2 }
        ]
      },
      "record": { "parent": "1" },
      "visible": ["a"],
      "stale": false
    },
    {
      "name": "親が変わって子の値が選べなくなったら stale",
      "field": {
        "field": "city",
        "optionsFrom": "prefecture",
        "options": [
          { "value": "shibuya", "label": "渋谷区", "when": "tokyo" },
          { "value": "kita", "label": "北区", "when": "osaka" }
        ]
      },
      "record": { "prefecture": "osaka", "city": "shibuya" },
      "visible": ["kita"],
      "stale": true
    },
    {
      "name": "選べる値のままなら stale ではない",
      "field": {
        "field": "city",
        "optionsFrom": "prefecture",
        "options": [
          { "value": "shibuya", "label": "渋谷区", "when": "tokyo" },
          { "value": "kita", "label": "北区", "when": "osaka" }
        ]
      },
      "record": { "prefecture": "tokyo", "city": "shibuya" },
      "visible": ["shibuya"],
      "stale": false
    },
    {
      "name": "子が空なら stale ではない（捨てるものが無い）",
      "field": {
        "field": "city",
        "optionsFrom": "prefecture",
        "options": [{ "value": "shibuya", "label": "渋谷区", "when": "tokyo" }]
      },
      "record": { "prefecture": "osaka", "city": "" },
      "visible": [],
      "stale": false
    }
  ]
}
