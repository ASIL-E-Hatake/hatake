{
  "_comment": "DTO derivation: each language parses `page`, calls deriveDto(page), and must produce exactly `expected`. Shapes are compared in order; constraint values are compared as strings to absorb numeric type differences between languages. Shape order is fixed: request, row, listResponse, queryParams, pathParams, then child (subTable) shapes in field-declaration order, deduped by name.",
  "cases": [
    {
      "name": "crud page yields request, row, listResponse, query and key shapes",
      "page": {
        "dsl_version": "1.0",
        "page": {
          "type": "crud",
          "id": "customer_master",
          "title": "顧客マスタ",
          "repository": "customerRepository",
          "key": "id",
          "search": {
            "filters": [
              { "field": "name", "label": "顧客名", "type": "text", "operator": "contains" },
              { "field": "openedAt", "label": "開設日", "type": "date", "operator": "between" }
            ]
          },
          "table": {
            "columns": [
              { "field": "id", "label": "ID" },
              { "field": "name", "label": "顧客名" },
              { "field": "credit", "label": "与信", "type": "number" }
            ]
          },
          "form": {
            "sections": [
              {
                "fields": [
                  { "field": "code", "label": "コード", "required": true,
                    "validators": [ { "type": "maxLength", "value": 6 } ] },
                  { "field": "name", "label": "顧客名", "required": true },
                  { "field": "credit", "label": "与信", "type": "number",
                    "validators": [ { "type": "min", "value": 0 }, { "type": "max", "value": 1000000 } ] },
                  { "field": "active", "label": "有効", "type": "checkbox" },
                  { "field": "openedAt", "label": "開設日", "type": "date" },
                  { "field": "email", "label": "メール",
                    "validators": [ { "type": "email" } ] },
                  { "field": "id", "label": "ID", "readOnly": true },
                  { "field": "label", "label": "表示名",
                    "computed": { "op": "concat", "fields": ["code", "name"] } }
                ]
              }
            ]
          }
        }
      },
      "expected": {
        "page": "customer_master",
        "shapes": [
          {
            "name": "CustomerMasterRequest",
            "role": "request",
            "members": [
              { "name": "code", "type": "string", "optional": false,
                "constraints": { "maxLength": "6" } },
              { "name": "name", "type": "string", "optional": false, "constraints": {} },
              { "name": "credit", "type": "number", "optional": true,
                "constraints": { "minimum": "0", "maximum": "1000000" } },
              { "name": "active", "type": "boolean", "optional": true, "constraints": {} },
              { "name": "openedAt", "type": "string", "optional": true,
                "constraints": { "format": "date" } },
              { "name": "email", "type": "string", "optional": true,
                "constraints": { "format": "email" } }
            ]
          },
          {
            "name": "CustomerMasterRow",
            "role": "row",
            "members": [
              { "name": "id", "type": "string", "optional": false, "constraints": {} },
              { "name": "name", "type": "string", "optional": false, "constraints": {} },
              { "name": "credit", "type": "number", "optional": false, "constraints": {} }
            ]
          },
          {
            "name": "CustomerMasterListResponse",
            "role": "listResponse",
            "members": [
              { "name": "items", "type": "array", "optional": false, "itemType": "object",
                "shape": "CustomerMasterRow", "constraints": {} },
              { "name": "totalCount", "type": "number", "optional": false, "constraints": {} }
            ]
          },
          {
            "name": "CustomerMasterQuery",
            "role": "queryParams",
            "members": [
              { "name": "name", "type": "string", "optional": true, "constraints": {} },
              { "name": "openedAt", "type": "array", "optional": true, "itemType": "string",
                "constraints": { "format": "date" } }
            ]
          },
          {
            "name": "CustomerMasterKey",
            "role": "pathParams",
            "members": [
              { "name": "id", "type": "string", "optional": false, "constraints": {} }
            ]
          }
        ]
      }
    },
    {
      "name": "search page yields only response and query shapes",
      "page": {
        "dsl_version": "1.0",
        "page": {
          "type": "search",
          "id": "order_search",
          "title": "受注照会",
          "repository": "orderRepository",
          "key": "orderNo",
          "search": {
            "filters": [
              { "field": "status", "label": "状態", "type": "select", "operator": "equals" }
            ]
          },
          "table": {
            "columns": [
              { "field": "orderNo", "label": "受注番号" },
              { "field": "amount", "label": "金額", "type": "number" }
            ]
          }
        }
      },
      "expected": {
        "page": "order_search",
        "shapes": [
          {
            "name": "OrderSearchRow",
            "role": "row",
            "members": [
              { "name": "orderNo", "type": "string", "optional": false, "constraints": {} },
              { "name": "amount", "type": "number", "optional": false, "constraints": {} }
            ]
          },
          {
            "name": "OrderSearchListResponse",
            "role": "listResponse",
            "members": [
              { "name": "items", "type": "array", "optional": false, "itemType": "object",
                "shape": "OrderSearchRow", "constraints": {} },
              { "name": "totalCount", "type": "number", "optional": false, "constraints": {} }
            ]
          },
          {
            "name": "OrderSearchQuery",
            "role": "queryParams",
            "members": [
              { "name": "status", "type": "string", "optional": true, "constraints": {} }
            ]
          },
          {
            "name": "OrderSearchKey",
            "role": "pathParams",
            "members": [
              { "name": "orderNo", "type": "string", "optional": false, "constraints": {} }
            ]
          }
        ]
      }
    },
    {
      "name": "an embedded subTable becomes an array member plus a child shape",
      "page": {
        "dsl_version": "1.0",
        "page": {
          "type": "form",
          "id": "order_entry",
          "title": "受注入力",
          "repository": "orderRepository",
          "key": "orderNo",
          "form": {
            "sections": [
              {
                "fields": [
                  { "field": "orderNo", "label": "受注番号", "required": true },
                  {
                    "field": "lines",
                    "label": "明細",
                    "type": "subTable",
                    "required": true,
                    "columns": [ { "field": "item", "label": "品名" } ],
                    "fields": [
                      { "field": "item", "label": "品名", "required": true },
                      { "field": "qty", "label": "数量", "type": "number", "required": true,
                        "validators": [ { "type": "min", "value": 1 } ] }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "expected": {
        "page": "order_entry",
        "shapes": [
          {
            "name": "OrderEntryRequest",
            "role": "request",
            "members": [
              { "name": "orderNo", "type": "string", "optional": false, "constraints": {} },
              { "name": "lines", "type": "array", "optional": false, "itemType": "object",
                "shape": "OrderEntryLinesRow", "constraints": {} }
            ]
          },
          {
            "name": "OrderEntryKey",
            "role": "pathParams",
            "members": [
              { "name": "orderNo", "type": "string", "optional": false, "constraints": {} }
            ]
          },
          {
            "name": "OrderEntryLinesRow",
            "role": "child",
            "members": [
              { "name": "item", "type": "string", "optional": false, "constraints": {} },
              { "name": "qty", "type": "number", "optional": false,
                "constraints": { "minimum": "1" } }
            ]
          }
        ]
      }
    },
    {
      "name": "a subTable with a source is not part of the parent request",
      "page": {
        "dsl_version": "1.0",
        "page": {
          "type": "form",
          "id": "order_entry_paged",
          "title": "受注入力",
          "repository": "orderRepository",
          "key": "orderNo",
          "form": {
            "sections": [
              {
                "fields": [
                  { "field": "orderNo", "label": "受注番号", "required": true },
                  {
                    "field": "lines",
                    "label": "明細",
                    "type": "subTable",
                    "source": { "repository": "orderLineRepository", "parentKey": "orderNo" },
                    "fields": [
                      { "field": "item", "label": "品名", "required": true }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "expected": {
        "page": "order_entry_paged",
        "shapes": [
          {
            "name": "OrderEntryPagedRequest",
            "role": "request",
            "members": [
              { "name": "orderNo", "type": "string", "optional": false, "constraints": {} }
            ]
          },
          {
            "name": "OrderEntryPagedKey",
            "role": "pathParams",
            "members": [
              { "name": "orderNo", "type": "string", "optional": false, "constraints": {} }
            ]
          },
          {
            "name": "OrderEntryPagedLinesRow",
            "role": "child",
            "members": [
              { "name": "item", "type": "string", "optional": false, "constraints": {} }
            ]
          }
        ]
      }
    },
    {
      "name": "a wizard request folds every step together",
      "page": {
        "dsl_version": "1.0",
        "page": {
          "type": "wizard",
          "id": "customer_wizard",
          "title": "顧客登録",
          "repository": "customerRepository",
          "key": "id",
          "steps": [
            {
              "id": "basic",
              "title": "基本情報",
              "fields": [ { "field": "code", "label": "コード", "required": true } ]
            },
            {
              "id": "contact",
              "title": "連絡先",
              "fields": [
                { "field": "email", "label": "メール",
                  "validators": [ { "type": "email" } ] }
              ]
            }
          ]
        }
      },
      "expected": {
        "page": "customer_wizard",
        "shapes": [
          {
            "name": "CustomerWizardRequest",
            "role": "request",
            "members": [
              { "name": "code", "type": "string", "optional": false, "constraints": {} },
              { "name": "email", "type": "string", "optional": true,
                "constraints": { "format": "email" } }
            ]
          },
          {
            "name": "CustomerWizardKey",
            "role": "pathParams",
            "members": [
              { "name": "id", "type": "string", "optional": false, "constraints": {} }
            ]
          }
        ]
      }
    }
  ]
}
