                        "type": "min",
                        "value": 0
                      },
                      {
                        "type": "max",
                        "value": 1000000
                      }
                    ]
                  },
                  {
                    "field": "active",
                    "label": "有効",
                    "type": "checkbox"
                  },
                  {
                    "field": "openedAt",
                    "label": "開設日",
                    "type": "date"
                  },
                  {
