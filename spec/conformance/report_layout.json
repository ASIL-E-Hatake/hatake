      "expected": [
        [
          "T|36|48|495.28|12|left|bold|売上明細表",
          "T|36|48|523.28|8|right|-|1 / 1",
          "T|36|62|120|8|left|-|受注番号",
          "T|162|62|397.28|8|right|-|金額",
          "R|36|65.6|523.28|0.5",
          "T|36|78.8|523.28|9|left|bold|顧客: 山田商事",
          "R|36|83.6|523.28|0.4",
          "T|36|94.8|120|9|left|-|SO-1",
          "T|162|94.8|397.28|9|right|-|¥100",
          "R|36|99.6|523.28|0.4",
          "T|36|110.8|120|9|left|bold|小計",
          "T|162|110.8|397.28|9|right|bold|¥100 / 1 件",
          "T|36|126.8|523.28|9|left|bold|顧客: 佐藤物産",
          "R|36|131.6|523.28|0.4",
          "T|36|142.8|120|9|left|-|SO-2",
          "T|162|142.8|397.28|9|right|-|¥250",
          "R|36|147.6|523.28|0.4",
          "T|36|158.8|120|9|left|bold|小計",
          "T|162|158.8|397.28|9|right|bold|¥250 / 1 件",
          "R|36|163.6|523.28|0.4",
          "R|36|165.2|523.28|0.4",
          "T|36|174.8|120|9|left|bold|合計",
          "T|162|174.8|397.28|9|right|bold|¥350 / 2 件"
        ]
      ]
    },
    {
