[
  { "computed": { "op": "concat", "fields": ["last", "first"], "separator": " " }, "record": { "last": "山田", "first": "太郎" }, "expected": "山田 太郎" },
  { "computed": { "op": "concat", "fields": ["a", "b"] }, "record": { "a": "x", "b": "y" }, "expected": "xy" },
  { "computed": { "op": "sum", "fields": ["price", "tax"] }, "record": { "price": 1000, "tax": 80 }, "expected": 1080 },
  { "computed": { "op": "sum", "fields": ["a", "b", "missing"] }, "record": { "a": 10, "b": 5 }, "expected": 15 },
  { "computed": { "op": "subtract", "fields": ["total", "paid"] }, "record": { "total": 1000, "paid": 300 }, "expected": 700 },
  { "computed": { "op": "product", "fields": ["qty", "unit"] }, "record": { "qty": 3, "unit": 150 }, "expected": 450 },

  { "$comment": "ここから: 明細（subTable）の行を畳む（field + of）。集約の語彙と実装はダッシュボードのカード・compare の検証と同じもの＝同じ数が出る。", "computed": { "op": "sum", "field": "lines", "of": "amount" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": 2500 },
  { "$comment": "count に of は要らない（何を数えるかは行そのもの）。", "computed": { "op": "count", "field": "lines" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": 3 },
  { "computed": { "op": "avg", "field": "lines", "of": "qty" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": 2 },
  { "computed": { "op": "min", "field": "lines", "of": "amount" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": 500 },
  { "computed": { "op": "max", "field": "lines", "of": "amount" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": 1200 },
  { "$comment": "数として読めない行は飛ばす（文字で来た数は読む）。合計は読めた値だけの和。", "computed": { "op": "sum", "field": "lines", "of": "amount" }, "record": { "lines": [{ "amount": "1200" }, { "amount": "" }, { "amount": "abc" }, { "amount": 300 }] }, "expected": 1500 },
  { "$comment": "行が1件も無いとき。count は 0、sum も 0（足すものが無い）。", "computed": { "op": "count", "field": "lines" }, "record": {}, "expected": 0 },
  { "computed": { "op": "sum", "field": "lines", "of": "amount" }, "record": { "lines": [] }, "expected": 0 },
  { "$comment": "avg は行が無ければ null（0 を返すと「平均 0 円」に見える）。", "computed": { "op": "avg", "field": "lines", "of": "amount" }, "record": { "lines": [] }, "expected": null },
  { "$comment": "of が無ければ畳めない（何を足すか決まらない）。validate が先に言う。", "computed": { "op": "sum", "field": "lines" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": null },
  { "$comment": "product は行を畳めない（同じレコードの項目を畳む op）。fields が無いので「何も掛けていない」1 が出る。validate が先に言う。", "computed": { "op": "product", "field": "lines", "of": "amount" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": 1 },
  { "$comment": "concat も同じ（行を並べる機能ではない）。", "computed": { "op": "concat", "field": "lines", "of": "amount" }, "record": { "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": "" },
  { "$comment": "行を畳むだけの op に field が無ければ null（同じレコードの項目には意味が無い）。", "computed": { "op": "count", "fields": ["a", "b"] }, "record": { "a": 1, "b": 2 }, "expected": null },
  { "$comment": "field と fields の両方を書いたら field が勝つ（validate が警告する形）。", "computed": { "op": "sum", "field": "lines", "of": "amount", "fields": ["a", "b"] }, "record": { "a": 1, "b": 2, "lines": [{ "amount": 1200, "qty": 2 }, { "amount": 800, "qty": 1 }, { "amount": 500, "qty": 3 }] }, "expected": 2500 },
  { "$comment": "行が配列でない（型が違う）ときは、行が無いのと同じに読む。", "computed": { "op": "sum", "field": "lines", "of": "amount" }, "record": { "lines": "1200" }, "expected": 0 },
  { "$comment": "ここから: 畳む前に行を絞る（where）。条件の言葉は visibleWhen と同じもの＝条件の書き方を2つ持たない。行1件に対して評価する。", "computed": { "op": "sum", "field": "lines", "of": "amount", "where": { "field": "status", "operator": "equals", "value": "active" } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": 1700 },
  { "computed": { "op": "count", "field": "lines", "where": { "field": "status", "operator": "equals", "value": "cancelled" } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": 1 },
  { "$comment": "結合（all / any / not）もそのまま使える。", "computed": { "op": "sum", "field": "lines", "of": "amount", "where": { "all": [{ "field": "amount", "operator": "gte", "value": 800 }] } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": 2000 },
  { "computed": { "op": "count", "field": "lines", "where": { "not": { "field": "status", "operator": "equals", "value": "cancelled" } } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": 2 },
  { "$comment": "行にその項目が無いときは isEmpty で拾える（キャンセル印が付いていない行だけ）。", "computed": { "op": "sum", "field": "lines", "of": "amount", "where": { "field": "cancelled", "operator": "isEmpty" } }, "record": { "lines": [{ "amount": 1200 }, { "amount": 800, "cancelled": true }, { "amount": 500 }] }, "expected": 1700 },
  { "$comment": "1件も残らないとき。sum は 0、avg は null（行が無いときと同じ）。", "computed": { "op": "sum", "field": "lines", "of": "amount", "where": { "field": "status", "operator": "equals", "value": "draft" } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": 0 },
  { "computed": { "op": "avg", "field": "lines", "of": "amount", "where": { "field": "status", "operator": "equals", "value": "draft" } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": null },
  { "$comment": "知らない演算子は false（条件と同じ規則）＝1件も残らない。validate が先に言う。", "computed": { "op": "sum", "field": "lines", "of": "amount", "where": { "field": "amount", "operator": "between", "value": [0, 1000] } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": 0 },
  { "$comment": "{ mode: ... } は行では決まらないので常に false＝1件も残らない。validate が先に言う。", "computed": { "op": "count", "field": "lines", "where": { "mode": "create" } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": 0 },
  { "$comment": "同じレコードの項目を畳む形に where を書いても効かない（絞る行が無い）。validate が先に言う。", "computed": { "op": "sum", "fields": ["a", "b"], "where": { "field": "a", "operator": "equals", "value": 999 } }, "record": { "a": 10, "b": 5 }, "expected": 15 },

  { "$comment": "ここから: 行を並べて1行にする（join）。数ではなく文字が出るので集約とは別物。区切りの既定は ', '（concat の既定が空なのは姓と名を詰めるため）。", "computed": { "op": "join", "field": "lines", "of": "item" }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": "鉛筆, ノート, 消しゴム" },
  { "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、" }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": "鉛筆、ノート、消しゴム" },
  { "$comment": "where で絞ってから並べられる（畳むのと同じ）。", "computed": { "op": "join", "field": "lines", "of": "item", "where": { "field": "status", "operator": "equals", "value": "active" } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": "鉛筆, 消しゴム" },
  { "$comment": "数も文字にして並べる（金額の一覧）。", "computed": { "op": "join", "field": "lines", "of": "amount", "separator": " / " }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": "1200 / 800 / 500" },
  { "$comment": "空の値は飛ばす（区切りだけが並ばないように）。", "computed": { "op": "join", "field": "lines", "of": "item" }, "record": { "lines": [{ "item": "鉛筆" }, { "item": "" }, { "item": null }, { "item": "ノート" }] }, "expected": "鉛筆, ノート" },
  { "$comment": "行が1件も無ければ空文字（0 ではない。文字を作る op なので）。", "computed": { "op": "join", "field": "lines", "of": "item" }, "record": { "lines": [] }, "expected": "" },
  { "$comment": "join に of が無ければ null（何を並べるか決まらない）。validate が先に言う。", "computed": { "op": "join", "field": "lines" }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }] }, "expected": null },
  { "$comment": "join は行を並べる op なので、同じレコードの項目には効かない（それは concat）。", "computed": { "op": "join", "fields": ["a", "b"] }, "record": { "a": "x", "b": "y" }, "expected": null },
  { "$comment": "金額の大きい順に3件だけ並べる。切ったぶんは黙って落とさず「ほか N 件」と言う。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "sort": { "field": "amount", "ascending": false }, "limit": 3 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "ペン、鉛筆、ノート、ほか 2 件" },
  { "$comment": "sort だけなら全部並べ替えて全部出す（切っていないので「ほか」は出ない）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "sort": { "field": "amount", "ascending": false } }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "ペン、鉛筆、ノート、消しゴム、定規" },
  { "$comment": "limit が行数以上なら、何も切っていないので「ほか」は出ない。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "limit": 9 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "鉛筆、ノート、消しゴム、ペン、定規" },
  { "$comment": "並べ替えずに limit だけなら、行の順のまま先頭から採る。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "limit": 2 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "鉛筆、ノート、ほか 3 件" },
  { "$comment": "「ほか N 件」の文言は定義で変えられる（{count} は**隠れた行数**）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "sort": { "field": "amount", "ascending": false }, "limit": 3, "overflow": "他 {count} 品目" }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "ペン、鉛筆、ノート、他 2 品目" },
  { "$comment": "overflow: \"\" は「黙って切る」と決めたということ（書いてあるので読める）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "sort": { "field": "amount", "ascending": false }, "limit": 3, "overflow": "" }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "ペン、鉛筆、ノート" },
  { "$comment": "絞ってから並べて、上位だけ採る（where → sort → limit の順）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "where": { "field": "status", "operator": "notEquals", "value": "cancelled" }, "sort": { "field": "amount", "ascending": false }, "limit": 2 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "ペン、鉛筆、ほか 2 件" },
  { "$comment": "値の無い行は、向きに関わらず後ろ（金額の無い行が「上位」に来ない）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "sort": { "field": "amount", "ascending": false }, "limit": 2 }, "record": { "lines": [{ "item": "台紙" }, { "item": "封筒", "amount": 100 }, { "item": "便箋", "amount": 200 }] }, "expected": "便箋、封筒、ほか 1 件" },
  { "$comment": "同じ値なら元の順（並べ替えの実装が言語で違っても答えが変わらない）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "sort": { "field": "amount", "ascending": false }, "limit": 2 }, "record": { "lines": [{ "item": "甲", "amount": 100 }, { "item": "乙", "amount": 100 }, { "item": "丙", "amount": 300 }] }, "expected": "丙、甲、ほか 1 件" },
  { "$comment": "sort の項目がどの行にも無ければ、並べ替えない（全部「値が無い」＝元の順）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "sort": { "field": "missing", "ascending": false }, "limit": 2 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": "鉛筆、ノート、ほか 3 件" },
  { "$comment": "並ぶものが1つも無ければ空文字（区切りや「ほか」だけが出ないように）。", "computed": { "op": "join", "field": "lines", "of": "item", "separator": "、", "limit": 2 }, "record": { "lines": [{ "item": "" }, { "item": null }, { "item": "封筒" }] }, "expected": "" },
  { "$comment": "limit は数を畳むときにも効く（金額の大きい順に3件の合計）。", "computed": { "op": "sum", "field": "lines", "of": "amount", "sort": { "field": "amount", "ascending": false }, "limit": 3 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": 5000 },
  { "$comment": "上位3件の平均（同じ3件を畳む）。", "computed": { "op": "avg", "field": "lines", "of": "amount", "sort": { "field": "amount", "ascending": false }, "limit": 3 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": 1666.6666666666667 },
  { "$comment": "count も上位だけ数える（limit まで）。", "computed": { "op": "count", "field": "lines", "sort": { "field": "amount", "ascending": false }, "limit": 3 }, "record": { "lines": [{ "item": "鉛筆", "amount": 1200, "status": "active" }, { "item": "ノート", "amount": 800, "status": "cancelled" }, { "item": "消しゴム", "amount": 500, "status": "active" }, { "item": "ペン", "amount": 3000, "status": "active" }, { "item": "定規", "amount": 100, "status": "active" }] }, "expected": 3 },
  { "$comment": "sort / limit は同じレコードを畳むモードには効かない（行が無いので）。", "computed": { "op": "sum", "fields": ["price", "tax"], "sort": { "field": "amount", "ascending": false }, "limit": 1 }, "record": { "price": 1000, "tax": 80 }, "expected": 1080 }
]
